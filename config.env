####################################### 以上名字不能改,长桥字段配置 #######################################
# 这个一定要有,会根据这个选择节点
LONGPORT_REGION=cn

LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

####################################### 以上名字不能改,长桥字段配置 #######################################

# 策略配置
# ============================================
# 交易标的配置
# ============================================
# 监控的股票列表（逗号分隔，支持美股、港股）
# AAPL.US,SOXL.US,TSLA.US,NVDA.US
Symbols=SOXL.US


# 交易时段配置（位掩码）
# 盘中(1)，盘后(2)，盘前(4)，夜盘(8)
# 1=仅盘中，3=盘中+盘后，7=盘中+盘后+盘前，15=盘中+盘后+盘前+夜盘
TradingSessions=7


# ============================================
# 订单配置
# ============================================
# 订单类型: "LIMIT" = 限价单, "MARKET" = 市价单
OrderType=LIMIT
# 下单方式: "QUANTITY" = 按数量, "AMOUNT" = 按金额
OrderMode=QUANTITY
# 滑点保护（仅限价单有效，价格偏移百分比）
SlippagePercent=0.005
# 订单超时未成交取消
OrderTimeOut=15
# 订单检查定时器时间
OrderCheckTime=3


# ============================================
# 资金管理
# ============================================
# 最小交易数量（股）
MinQuantity=1
# 最大交易数量（股）
MaxQuantity=100
# 基础资金（美元）- 用于计算交易数量
BaseAmount=100000


# ============================================
# 风控配置
# ============================================
# 单日最大交易次数
MaxDailyTrades=100
# 单只股票最大持仓比例（%）
MaxPositionPercent=100
# 止损比例（%）
StopLossPercent=20


# ============================================
# 网格策略配置
# ============================================
# RSI相关配置
# 总资金
StrategyTotalCapital=100000
# 最大亏损比例，默认0.15 (15%)
StrategyMaxLossRatio=0.15
# 仓位上限，默认0.3 (30%)
StrategyMaxPositionRatio=0.3

# 默认策略: TimeTrend
# GridPercent 百分比网格
# TimeSignal 时间信号
# TimeTrend 时间趋势
StrategyType=TimeTrend
# 最多几条未成交订单
StrategyUnSoldOrderNum=1
# 盘前前N分钟不买卖
StrategySessionPreFirstMinute=30
# 盘前后N分钟不买卖
StrategySessionPreLastMinute=30
# 盘中前N分钟不买卖
StrategySessionRegularFirstMinute=15
# 盘中后N分钟不买卖
StrategySessionRegularLastMinute=15
# 盘后前N分钟不买卖
StrategySessionAfterFirstMinute=30
# 盘后后N分钟不买卖
StrategySessionAfterLastMinute=30
# 盘前购买数量
StrategyPreQuantityStep=50
# 盘中购买数量
StrategyRegularQuantityStep=100
# 盘后购买数量
StrategyAfterQuantityStep=50
# 盘中前N分钟（购买数量减半）
StrategyRegularFirstMinute=15
# 盘中后N分钟（购买数量减半）
StrategyRegularAfterMinute=15
# 多少秒执行1次策略(默认1秒)
StrategyOrderLogicSec=1
# 连续亏损StrategyContinueLossNum切换策略
StrategyContinueLossSwitch=false
# 连续亏损N次
StrategyContinueLossNum=2
# 连续亏损N次暂停交易分钟
StrategyContinueLossStopMinute=3
# 盘后->夜盘前N分钟无数据自动退出(会自动统计盈亏)
StrategyOvernightExitFirstMinute=3

# 秒级数据保留上限(秒)
SecondHistoryLimit=3600
# 分钟级数据保留上限(分钟, 1440=1天)
MinuteHistoryLimit=1440

# MACD每N分推播或检测到跨天/跨时段，强制全量计算校准一次,这样可以彻底消除 EMA 增量计算积累的浮点误差
MACDMinuteUpdateCount=600
# MACD每N秒推播或检测到跨天/跨时段，强制全量计算校准一次,这样可以彻底消除 EMA 增量计算积累的浮点误差
MACDSecondUpdateCount=1800


# 开仓冷却时间
OpenCooldown=180
# MACD快线周期，默认12
MACDFast=12
# MACD慢线周期，默认26
MACDSlow=26
# MACD信号线周期，默认9
MACDSignal=9

# TimeSignal 策略
# 信号类型 SignalTrendType
# SignalTrendLong 1 只做多
# SignalTrendShort 2 只做空
SignalType=1
# 本分钟N秒后使用当前
SignalCurrentSec=55
# RSI 超买
SignalRSIOverBuy=80
# RSI 超卖
SignalRSIOverSell=20
# 信号做多变化百分比（未达到不频繁交易）
SignalLongPresent=0
# 信号做空变化百分比（未达到不频繁交易）
SignalShortPresent=0
# 信号数量
SignalWindow=30
#  RSI平滑周期
SignalRSI=14
#  RSI平滑周期倍数
SignalRSIBase=3
# ATR平滑周期
SignalATR=15
# atr噪声系数
SignalATRNoiseThresholdFactor=0.04
# atr噪声最小值
SignalATRNoiseThresholdMin=0.01
# 动态成交量周期
SignalVolumeDynamic=30
# 动态成交量系数
SignalVolumeFactor=1.5


# TimeTrend 策略
# 时间加权 PriceType
# 秒级类型 0 
# 分级类型 1
TrendPriceType=0
# MALong
TrendMALong=300
# MAShort
TrendMAShort=180
# TrendMAPre
TrendMAPre=60
# 趋势需要连续一致的次数
TrendConfirm=5
# 资金流向统计周期(秒)
TrendFlowPeriod=600
# 开仓净流向阈值(0~1,越大要求买方/卖方越强势)
TrendFlowEntryThreshold=0.2
# 平仓净流向阈值(正数,低于此值反向资金流触发提前平仓)
TrendFlowExitThreshold=0.1
# atr系数
TrendAtrFactor=0.7
# 成交量系数
TrendVolumeFactor=1.2
# 成交量最大系数（放巨量往往意味着换手剧烈，趋势即将枯竭）
TrendVolumeMaxFactor=5.0
# 止损百分比上限
TrendStopMaxLoss=0.03
# 做多atr止损倍数
TrendATRLongStopBase=10.0
# 做空atr止损倍数
TrendATRShortStopBase=10.0
# 做多atr止赢倍数
TrendATRLongWinBase=10.0
# 做空atr止赢倍数
TrendATRShortWinBase=10.0


# ============================================
# 网格策略配置
# ============================================
# 时间加权 PriceType
# 秒级类型 0 
# 分级类型 1
GridPriceType=0
# 策略重置基础价时间(0不重置)
GridWaitDuration=600
# MALong
GridATR=600
# GridMAPre
GridMAPre=60

# 止盈止损配置
# 做多atr止损倍数
GridATRLongStopBase=8.0
# 做空atr止损倍数
GridATRShortStopBase=8.0
# 做多atr止赢倍数
GridATRLongWinBase=10.0
# 做空atr止赢倍数
GridATRShortWinBase=10.0
# 做多移动止盈最大倍数(超过这个倍数止盈)
GridMoveLongMaxMultiple=3.3
# 做空移动止盈最大倍数(超过这个倍数止盈)
GridMoveShortMaxMultiple=3.3
# 移动止盈利润百分比(进入盈利保护)
GridMoveProfitPercent=0.003
# 移动止盈基础百分比
GridMoveBasePercent=0.003
# 移动止盈百分比
GridMovePercent=0.0015

# 价格下跌百分比步长价格下跌步长（最高价格为准-步长,买入）
GridPercentStep=0.01


# ============================================
# 测试策略配置
# ============================================
TestBuyQuantity=10      # 每次买入数量（股）
TestHoldSeconds=30      # 持仓时间（秒）


# ============================================
# 日志配置
# ============================================
# log缓存最大数量
LogChanSize=10000
# log超过N条写入文件
LogFlushCount=1000
# log超过N秒写入文件
LogFlushDuration=30

# 日志级别: DEBUG, INFO, WARN, ERROR
LogLevel=WARN
# 是否输出详细日志
LogEnabled=true

# HTML日志级别: DEBUG, INFO, WARN, ERROR
HTMLLogLevel=DEBUG
# 是否启用HTML日志
HTMLLogEnabled=false

# 控制台日志级别: DEBUG, INFO, WARN, ERROR
CmdLevel=WARN
# 是否启用控制台日志
CmdEnabled=false


# ============================================
# 时区配置
# ============================================
TimeZone=America/New_York


# ============================================
# 测试模式配置
# ============================================
# 是否开启测试
TestOpen=true
# 测试策略
TestStrategy=price
# 是否开启macd,price绘图
TestOpenDraw=false
# 测试数据表
TestXlsx=test_data/test20260612.xlsx
# 测试定时器时间
TestTimeTicker=1
# 测试时间缩放因子(1正常时间,>=1则虚拟设置时间跑)
TestTimeScale=2
# 开始索引类型(0正序,其他逆序)
TestPriceIndexType=0
# 测试价位开始索引
TestPriceIndexStart=0
# 测试价位结束索引(0最后,不为0到指定价位索引结束)
TestPriceIndexEnd=0
